/* =========================================================
   APP
========================================================= */

function App() {
  const [menuOpen, setMenuOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [openDropdown, setOpenDropdown] = useState(null);

  /* FAQ OPEN STATE */
  const [openFaq, setOpenFaq] = useState(null);

  /* -------------------------------------------------------
     NAVBAR SCROLL
  ------------------------------------------------------- */

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 18);
    };

    window.addEventListener("scroll", handleScroll, {
      passive: true,
    });

    return () => {
      window.removeEventListener("scroll", handleScroll);
    };
  }, []);

  /* -------------------------------------------------------
     CLOSE MOBILE MENU WHEN SCREEN BECOMES DESKTOP
  ------------------------------------------------------- */

  useEffect(() => {
    const handleResize = () => {
      if (window.innerWidth > 760) {
        setMenuOpen(false);
      }
    };

    window.addEventListener("resize", handleResize);

    return () => {
      window.removeEventListener("resize", handleResize);
    };
  }, []);

  /* -------------------------------------------------------
     PREVENT BODY SCROLL WHEN MOBILE MENU OPEN
  ------------------------------------------------------- */

  useEffect(() => {
    if (menuOpen && window.innerWidth <= 760) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }

    return () => {
      document.body.style.overflow = "";
    };
  }, [menuOpen]);

  /* -------------------------------------------------------
     PREMIUM SCROLL REVEAL
     Replays when elements leave and re-enter the viewport.
  ------------------------------------------------------- */

  useEffect(() => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      return;
    }

    const revealSelector = [
      ".section .reveal",
      ".section-head",
      ".stat",
      ".client-card",
      ".review-card",
      ".reviews-head",
      ".faq-heading",
      ".faq-list",
      ".cta",
      ".footer-grid",
      ".footer-bottom",
    ].join(",");

    const revealElements = document.querySelectorAll(revealSelector);

    revealElements.forEach((element) => {
      element.classList.add("scroll-reveal");
    });

    document.documentElement.classList.add("scroll-motion-ready");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          } else {
            entry.target.classList.remove("is-visible");
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -6% 0px",
      }
    );

    revealElements.forEach((element) => observer.observe(element));

    return () => {
      observer.disconnect();
      document.documentElement.classList.remove("scroll-motion-ready");
      revealElements.forEach((element) => {
        element.classList.remove("scroll-reveal", "is-visible");
      });
    };
  }, []);

  /* -------------------------------------------------------
     CLOSE MENU
  ------------------------------------------------------- */

  const closeMenu = () => {
    setMenuOpen(false);
    setOpenDropdown(null);
  };

  /* -------------------------------------------------------
     NAVIGATION CLICK
  ------------------------------------------------------- */

  const handleNavClick = (event, target) => {
    event.preventDefault();

    setMenuOpen(false);

    const element = document.getElementById(target);

    if (element) {
      setTimeout(() => {
        element.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }, 50);
    }
  };

  /* -------------------------------------------------------
     LOGO CLICK
  ------------------------------------------------------- */

  const handleLogoClick = (event) => {
    event.preventDefault();

    setMenuOpen(false);

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  };

  return (
    <div className="site">

      {/* =====================================================
          MOBILE MENU BACKDROP
      ====================================================== */}

      {menuOpen && (
        <div
          className="mobile-menu-backdrop"
          onClick={closeMenu}
          aria-hidden="true"
        />
      )}

      {/* =====================================================
          NAVBAR
      ====================================================== */}

      <header
        className={`navbar ${
          scrolled ? "navbar--scrolled" : ""
        } ${menuOpen ? "navbar--menu-open" : ""}`}
      >

        {/* LOGO */}

        <a
          className="brand"
          href="#home"
          onClick={handleLogoClick}
          aria-label="TechMisai Home"
        >
          <img
            src={techmisaiLogo}
            alt="TechMisai"
            className="brand-logo"
          />
        </a>

        {/* NAV LINKS */}

        <nav
          id="mobile-navigation"
          className={`nav-links ${
            menuOpen ? "nav-links--open" : ""
          }`}
          aria-label="Main navigation"
        >

          {navItems.map((item) => {
            const hasDropdown =
              item.label === "Products" || item.label === "Services";

            if (!hasDropdown) {
              return (
                <a
                  key={item.target}
                  href={`#${item.target}`}
                  className="nav-link"
                  onClick={(event) =>
                    handleNavClick(event, item.target)
                  }
                >
                  <span>{item.label}</span>
                </a>
              );
            }

            const items = item.label === "Products" ? products : services;
            const isOpen = openDropdown === item.label;

            return (
              <div
                key={item.target}
                className={`nav-dropdown ${isOpen ? "nav-dropdown--open" : ""}`}
                onMouseEnter={() => {
                  if (window.innerWidth > 760) setOpenDropdown(item.label);
                }}
                onMouseLeave={() => {
                  if (window.innerWidth > 760) setOpenDropdown(null);
                }}
              >
                <button
                  type="button"
                  className="nav-link nav-dropdown-trigger"
                  aria-expanded={isOpen}
                  onClick={() =>
                    setOpenDropdown((current) =>
                      current === item.label ? null : item.label
                    )
                  }
                >
                  <span>{item.label}</span>
                  <ChevronDown size={12} aria-hidden="true" />
                </button>

                <div className="nav-dropdown-menu">
                  {items.map(([title, subtitle]) => (
                    <a
                      key={title}
                      href={`#${item.target}`}
                      className="nav-dropdown-item"
                      onClick={(event) => {
                        handleNavClick(event, item.target);
                        setOpenDropdown(null);
                      }}
                    >
                      <strong>{title}</strong>
                      <span>{subtitle}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}

        </nav>

        {/* NAV ACTIONS */}

        <div className="nav-actions">

          <a
            className="btn btn-primary btn-small"
            href="#contact"
            onClick={(event) =>
              handleNavClick(event, "contact")
            }
          >
            Get Started
            <ArrowRight size={15} />
          </a>

          <button
            type="button"
            className="menu-btn"
            aria-label={
              menuOpen
                ? "Close navigation menu"
                : "Open navigation menu"
            }
            aria-expanded={menuOpen}
            aria-controls="mobile-navigation"
            onClick={() =>
              setMenuOpen((previous) => !previous)
            }
          >
            {menuOpen ? (
              <X
                size={21}
                strokeWidth={2.2}
              />
            ) : (
              <Menu
                size={21}
                strokeWidth={2.2}
              />
            )}
          </button>

        </div>

      </header>

      {/* =====================================================
          MAIN
      ====================================================== */}

      <main>

        {/* ===================================================
            HERO
        ==================================================== */}

        <section
          id="home"
          className="hero"
        >

          <div
            className="hero-art"
            aria-hidden="true"
          />

          <div className="container hero-content reveal">

            <div className="hero-copy">

              <div className="eyebrow">
                AI <span>•</span> DESIGN <span>•</span> TECHNOLOGY
              </div>

              <h1>
                Build smarter.
                <br />
                Create <em>what’s next.</em>
              </h1>

              <p>
                TechMisai transforms ideas into intelligent
                digital experiences, products and solutions
                built for the future.
              </p>

              <div className="hero-actions">

                <a
                  className="btn btn-primary"
                  href="#solutions"
                  onClick={(event) =>
                    handleNavClick(event, "solutions")
                  }
                >
                  Explore Solutions
                  <ArrowRight size={17} />
                </a>

                <a
                  className="btn btn-outline"
                  href="#contact"
                  onClick={(event) =>
                    handleNavClick(event, "contact")
                  }
                >
                  Let’s Talk
                </a>

              </div>

              <div className="trust-line">

                <span>
                  Trusted by innovative teams worldwide
                </span>

                <div className="trust-names">
                  <b>NovaTech</b>
                  <b>BrightPath</b>
                  <b>Skyline</b>
                  <b>Everwell</b>
                  <b>PixelForge</b>
                </div>

              </div>

            </div>

          </div>

        </section>

        {/* ===================================================
            SOLUTIONS
        ==================================================== */}

        <section
          id="solutions"
          className="section solutions"
        >

          <div className="container">

            <div className="section-head reveal">

              <div>

                <div className="eyebrow">
                  OUR SOLUTIONS
                </div>

                <h2>
                  Technology built
                  <br />
                  for <em>what’s next.</em>
                </h2>

              </div>

              <div className="section-intro">

                <p>
                  We combine strategy, technology, and
                  creativity to deliver intelligent solutions
                  that help businesses grow, adapt and stay
                  ahead.
                </p>

                <a
                  href="#services"
                  onClick={(event) =>
                    handleNavClick(event, "services")
                  }
                >
                  View all solutions
                  <ArrowRight size={15} />
                </a>

              </div>

            </div>

            <div className="card-grid four">

              {solutions.map(
                ([title, text, Icon]) => (
                  <article
                    className="glass-card reveal"
                    key={title}
                  >

                    <div className="icon-box">
                      <Icon size={20} />
                    </div>

                    <h3>{title}</h3>

                    <p>{text}</p>

                    <a
                      href="#contact"
                      className="card-arrow"
                      aria-label={`Learn more about ${title}`}
                      onClick={(event) =>
                        handleNavClick(event, "contact")
                      }
                    >
                      <ArrowRight size={17} />
                    </a>

                  </article>
                )
              )}

            </div>

            {/* STATS */}

            <div className="stats-bar reveal">

              {stats.map(
                ([value, label, Icon]) => (
                  <div
                    className="stat"
                    key={label}
                  >

                    <div className="stat-icon">
                      <Icon size={20} />
                    </div>

                    <div>
                      <strong>{value}</strong>
                      <span>{label}</span>
                    </div>

                  </div>
                )
              )}

            </div>

          </div>

        </section>

        {/* ===================================================
            PRODUCTS
        ==================================================== */}

        <section
          id="products"
          className="section products"
        >

          <div className="container">

            <div className="section-head products-head reveal">

              <div>

                <div className="eyebrow">
                  OUR PRODUCTS
                </div>

                <h2>
                  Digital products built
                  <br />
                  for <em>real impact.</em>
                </h2>

              </div>

              <div className="section-intro">

                <p>
                  Powerful products designed to help teams
                  automate, understand and grow their
                  businesses faster.
                </p>

              </div>

            </div>

            <div className="product-grid">

              {products.map(
                ([title, label, text, Icon], index) => (
                  <article
                    className={`product-card ${
                      index === 0
                        ? "product-card-featured"
                        : ""
                    } product-reveal`}
                    key={title}
                  >

                    <div className="product-card-top">

                      <div className="product-icon">
                        <Icon size={22} />
                      </div>

                      <span className="product-number">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                    </div>

                    <div className="product-content">

                      <span className="product-label">
                        {label}
                      </span>

                      <h3>
                        {title}
                      </h3>

                      <p>
                        {text}
                      </p>

                    </div>

                    <a
                      href="#contact"
                      className="product-link"
                      onClick={(event) =>
                        handleNavClick(event, "contact")
                      }
                    >
                      Explore product
                      <ArrowRight size={16} />
                    </a>

                  </article>
                )
              )}

            </div>

          </div>

        </section>

        {/* ===================================================
            CLIENTS
        ==================================================== */}

        <section
          id="clients"
          className="section clients-section clients-scroll-driven"
        >

          <div className="container">

            <div className="section-head clients-head reveal">

              <div>

                <div className="eyebrow">
                  OUR CLIENTS
                </div>

                <h2>
                  Partnerships built
                  <br />
                  for <em>long-term impact.</em>
                </h2>

              </div>

              <div className="section-intro">

                <p>
                  We work closely with businesses to turn
                  ideas, challenges and opportunities into
                  meaningful digital products.
                </p>

              </div>

            </div>

            <div className="client-carousel-wrap client-circular-gallery-wrap reveal">
              <div className="client-circular-gallery-stage">
                <CircularGallery
                  items={clientCarouselItems}
                  bend={3}
                  textColor="#ffffff"
                  borderRadius={0.05}
                  scrollEase={0.02}
                  fontUrl="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap"
                  font="bold 30px Orbitron"
                  className="client-circular-gallery"
                />
              </div>
            </div>

          </div>

        </section>

        {/* ===================================================
            CLIENT REVIEWS
        ==================================================== */}

        <section
          id="client-reviews"
          className="section reviews-section"
        >

          <div className="container">

            <div className="reviews-head reveal">

              <div>

                <div className="eyebrow">
                  CLIENT REVIEWS
                </div>

                <h2>
                  What our
                  <br />
                  <em>partners say.</em>
                </h2>

              </div>

              <p>
                Real collaboration starts with understanding
                the people, goals and challenges behind every
                project.
              </p>

            </div>

            <div className="reviews-grid">

              {clientReviews.map(
                (review, index) => (
                  <article
                    className="review-card reveal"
                    key={review.name}
                  >

                    <div className="review-top">

                      <div className="quote-icon">
                        <Quote size={20} />
                      </div>

                      <div className="review-stars">

                        {[1, 2, 3, 4, 5].map(
                          (star) => (
                            <Star
                              key={star}
                              size={14}
                              fill="currentColor"
                            />
                          )
                        )}

                      </div>

                    </div>

                    <p className="review-text">
                      “{review.review}”
                    </p>

                    <div className="review-author">

                      <div className="review-avatar">
                        {String(index + 1).padStart(2, "0")}
                      </div>

                      <div>

                        <strong>
                          {review.name}
                        </strong>

                        <span>
                          {review.role}
                        </span>

                      </div>

                    </div>

                  </article>
                )
              )}

            </div>

          </div>

        </section>

        {/* ===================================================
            FAQ
        ==================================================== */}

        <section
          id="faq"
          className="faq-section"
        >

          <div className="faq-inner">

            {/* FAQ HEADING */}

            <div className="faq-heading">

              <span className="section-kicker">
                FAQ
              </span>

              <h2>
                Questions?
                <br />
                <span>We've got answers.</span>
              </h2>

              <p>
                Everything you need to know about working
                with TechMisai and building your next
                digital product.
              </p>

            </div>

            {/* FAQ LIST */}

            <div className="faq-list">

              {faqs.map((faq, index) => {

                const isOpen = openFaq === index;

                return (
                  <div
                    className={`faq-item ${
                      isOpen ? "faq-open" : ""
                    }`}
                    key={faq.question}
                  >

                    <button
                      type="button"
                      className="faq-question"
                      onClick={() =>
                        setOpenFaq(
                          isOpen ? null : index
                        )
                      }
                      aria-expanded={isOpen}
                    >

                      <span>

                        <small>
                          {String(index + 1).padStart(2, "0")}
                        </small>

                        {faq.question}

                      </span>

                      <span className="faq-plus">
                        {isOpen ? "−" : "+"}
                      </span>

                    </button>

                    <div className="faq-answer">

                      <p>
                        {faq.answer}
                      </p>

                    </div>

                  </div>
                );
              })}

            </div>

          </div>

        </section>

        {/* ===================================================
            FEATURED CASE STUDY
        ==================================================== */}

        <section
          id="case-study"
          className="section case-study"
        >

          <div className="container case-grid">

            <div className="case-copy reveal">

              <div className="eyebrow">
                FEATURED CASE STUDY
              </div>

              <h2>
                Transforming ideas into intelligent digital{" "}
                <em>experiences.</em>
              </h2>

              <p>
                We helped a leading retail brand build a
                scalable platform with AI-driven
                personalization, resulting in higher
                engagement and stronger conversions.
              </p>

              <a
                className="text-link"
                href="#contact"
                onClick={(event) =>
                  handleNavClick(event, "contact")
