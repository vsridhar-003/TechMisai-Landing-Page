              </div>

              <a
                className="btn btn-white"
                href="mailto:hello@techmisai.com"
                onClick={closeMenu}
              >
                Talk to an Expert
                <ArrowRight size={16} />
              </a>

            </div>

          </div>

        </section>

        {/* CONTACT TARGET */}

        <span
          id="contact"
          className="contact-anchor"
          aria-hidden="true"
        />

