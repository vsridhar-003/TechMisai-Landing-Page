                        fill="none"
                        stroke="url(#g)"
                        strokeWidth="4"
                      />

                      <defs>

                        <linearGradient
                          id="g"
                          x1="0"
                          x2="1"
                          y1="0"
                          y2="0"
                        >

                          <stop
                            offset="0"
                            stopColor="#6c4cff"
                          />

                          <stop
                            offset="1"
                            stopColor="#ef62b6"
                          />

                        </linearGradient>

                      </defs>

                    </svg>

                  </div>

                </div>

              </div>

            </div>

          </div>

        </section>

        {/* ===================================================
            SERVICES
        ==================================================== */}

        <section
          id="services"
          className="section services"
        >

          <div className="container">

            <div className="section-head compact reveal">

              <div>

                <div className="eyebrow">
                  OUR SERVICES
                </div>

                <h2>
                  End-to-end technology solutions
                </h2>

              </div>

